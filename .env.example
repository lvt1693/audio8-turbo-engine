# Audio8 TTS (the Queen TTS API on Edge0/Audio8-TTS-Realistic-0.6b) -- every setting, in this ONE file, for bare metal
# (serve/run_profile.sh) and Docker. Copy it to .env (the repo root, next to docker-compose.yml) and edit; .env is never
# committed and no script rewrites it. Docker: docker compose up -d (recreates the container); compose reads it for its
# own ${...} and as the container's whole environment. The image's CMD fixes the listening address and port inside the
# container (0.0.0.0:29100).
# Paths are relative to serve/, the container's working dir: ../models = ./models (mounted read-only at /app/models),
# ../data = ./data (mounted at /app/data), what the server reads and writes. One key per line, comments on their own
# lines (compose parses the file). A key left out takes the built-in default; the commented ones at the end show theirs.

# ===== this machine =====
# the GPU(s) of the engine workers: physical ids in nvidia-smi order, one worker each, e.g. 2 or 1,2. The container
# sees every GPU and each worker pins its own; set it: empty = whatever GPU 0 is
TTS_GPUS=0
# the address the API is published on (127.0.0.1 = this machine only, e.g. behind HAProxy / a reverse proxy; 0.0.0.0 =
# the same network too: http://<ip>:29000; a machine that also has a public address: its LAN IP instead, since ufw
# does not filter a port Docker publishes) and the host port
TTS_BIND=127.0.0.1
TTS_PUBLIC_PORT=29100
# bare metal (run_profile.sh): the API's address and port. Never 29000 / 29001 on a machine that also runs Queen TTS
TTS_HOST=0.0.0.0
TTS_PORT=29100
# the per-day limits (rpd) and the log's times follow it (the image alone is UTC)
TZ=Asia/Ho_Chi_Minh
# the base of the audio_url bot/tts returns; empty = the address the request was sent to (right when clients call the
# server directly). Behind a TLS reverse proxy that is http://<host>: set https://<domain>
BOT_TTS_PUBLIC_HOST=
# Datadog (serve/observability.py, the same contract as streaming-spark): every request and every synthesis is a JSON
# line on stdout (log_type:metric events http_request / tts_synth / tts_cache, and a request line with endpoint,
# input_text, normalized_text, time_to_first_audio_ms, audio_duration_ms ...), which the agent collects from the
# container (docker-compose.yml labels). The service and env they are tagged with:
DD_SERVICE=audio8-tts
DD_ENV=production

# ===== where things are (relative = from serve/) =====
TTS_MODEL_PATH=../models/Audio8-TTS-Realistic-0.6b
# one .pt per voice = its reference's codec codes + transcript; voices are model-specific: made from <name>.wav +
# <name>.txt by create_speakers.py
TTS_SPEAKERS_DIR=../data/speakers/speakers_a8
# the API keys and the admin console's database (auth.py)
TTS_AUTH_DIR=../data/auth
# API keys: open = not needed (a key that is sent keeps its limits), enforce = every request needs one, report = only
# logged. The mode until the admin console (/admin/, Bảo mật) sets one; once set there, the console's wins
TTS_AUTH_MODE=open
BOT_TTS_CACHE_DIR=../data/bot_tts_cache
# the tuned GEMM table, per GPU name (the first start on a new GPU model tunes it: ~8 min)
TTS_GEMM_TUNE_CACHE=../data/gemm_tune.json
# torch's download cache: the word aligner's weights (timing.py, MMS_FA, 1.2 GB; fetched on first use when missing)
TORCH_HOME=../data/cache/torch
# the compiled Triton kernels (the first start compiles them; kept across container restarts)
TRITON_CACHE_DIR=../data/cache/triton
# other download / compile caches (the codec's Hugging Face files, librosa's numba), kept across container restarts
HF_HOME=../data/cache/hf
NUMBA_CACHE_DIR=../data/cache/numba

# ===== engine and capacity =====
TTS_DEVICE=cuda:0
TTS_ATTN=sdpa
# concurrent streams per GPU (slots): the KV cache is 24 MB a slot at TTS_MAX_SEQ=2048; past the slots a request
# waits for one. RTX 3090 (2026-10-31, bench_ccu sustained 60 s, the card at its 350 W cap): 112 -> P95 TTFA 190 ms /
# RTF 0.65, 128 -> 210 ms / 0.74, 160 -> 0.85
TTS_BATCH_SIZE=128
# voice families kept on the GPU besides the pinned ones (~3-4 MB of prompt-prefix KV per voice)
TTS_VOICE_SLOTS=32
# the KV length of a slot = the prompt (system turn + reference transcript + reference frames, ~250 for a 7 s reference)
# + the text + the audio frames (21.5 a second); at most the checkpoint's 2048
TTS_MAX_SEQ=2048
# a longer text is a 400 (it must fit TTS_MAX_SEQ)
TTS_MAX_TEXT_CHARS=600
# the streamed chunk in 21.5 Hz frames (11 ~ 0.5 s), and the first one (46 ms), doubling up to it
TTS_FRAMES_PER_CHUNK=11
TTS_FIRST_CHUNK_FRAMES=1
# the output sample rate (Hz)
TTS_OUT_SR=16000

# ===== styles: the plain 0.6B reads every line, a style (`instruct` = a preset key) picks the family's voice made for
# it ({family}_{lang}_{speed}[_{accent}]_{style}, an ElevenLabs reference read in that style), so a styled line costs
# what a plain one costs; a family without the style reads its plain voice, free text is a 400 =====
TTS_INSTRUCT=1
TTS_INSTRUCT_MODE=voices
TTS_INSTRUCT_DEFAULT=happy

# ===== bot/tts and the dual endpoints (dual_vietnamese_english, english, vietnamese): whatever `speaker` they are
# sent, the accent (`lora` / `accent`, default north) picks the voice; a request without `instruct` reads in
# TTS_INSTRUCT_DEFAULT's style (happy; user 2026-10-24), instruct=none plain =====
TTS_DUAL_LOCK=1
TTS_DUAL_BY_ACCENT=north:pika-pitch-2,south:pika-2
TTS_DUAL_SPEAKER=pika-2
TTS_DUAL_FALLBACK=pika-2
# their own default instead of TTS_INSTRUCT_DEFAULT (none = plain)
#TTS_DUAL_INSTRUCT_DEFAULT=
# a speaker name's own style when the request sends no instruct (name:style, comma-separated; every endpoint)
#TTS_SPEAKER_INSTRUCT=simp_en_slow_3:excited

# ===== decoding (the checkpoint's sampling: top-k, top-p on the untempered softmax, then the temperature; one set
# for the semantic token and the 9 acoustic codebooks; repetition-aware resampling of the semantic token from the
# checkpoint's config). The model card's values =====
TTS_DO_SAMPLE=true
TTS_TEMPERATURE=0.8
TTS_TOP_K=50
TTS_TOP_P=0.95
# the most codec frames of a line (~ its longest audio; also capped by TTS_MAX_SEQ)
TTS_MAX_NEW_TOKENS=2048
# a row's codec decoder starts clean (0: the checkpoint's own decode_audio) or from its voice's reference decoded (1:
# as if reference and line were one recording; every voice primed at startup, snapshots in <speakers dir>.snaps)
#TTS_VOC_PRIME=0

# ===== speed: the output slowed, pitch kept (tempo.py: sox WSOLA, streamed; 1 = off) =====
# every normal-speed voice, every language (2026-10-24); a sound (<giggle>) is never slowed
TTS_NORMAL_TEMPO=0.8
# the Vietnamese normal-speed voices (*_vi_*) instead (unset = TTS_NORMAL_TEMPO; 0.97 = prod .34's speed, 2026-10-25)
TTS_VI_NORMAL_TEMPO=0.97
# the slow voices ({family}_{lang}_slow...), read from a slowed reference and slowed again here
#TTS_SLOW_TEMPO=0.8

# ===== rarely changed: the defaults =====
# the most prompt tokens of one batched prefill
#TTS_PREFILL_TOKENS=8192
# Triton bf16 GEMMs (small-M tiles) where faster than cuBLAS, tuned at the first start (TTS_GEMM_TUNE_CACHE)
#TTS_TRITON_GEMM=1
# the silence at a language switch with no punctuation (engine_worker.py, README "Joined switches")
#TTS_SWITCH_GAP=0.11
# Vietnamese text -> spoken words first (numbers, dates, money, units, acronyms; vi_normalize.py): the model reads raw
# digits in Chinese
#TTS_VI_NORMALIZE=1
# tags in the text, every endpoint (agent.md): known = the known [..] / <...> tags work (<eng>, <pause:800ms>, <slow>,
# <em>; a sound <giggle> where the voice family has it: yuna), every other tag is removed and the text around it read;
# strict = an unknown tag is a 400; 0 = every <...> removed
#TTS_ANGLE_TAGS=known

# ===== tools only (serve/eleven_refs.py: making voices with ElevenLabs) =====
#ELEVENLABS_API_KEY=
